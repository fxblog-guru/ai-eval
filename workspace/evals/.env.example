# Copy to .env.<env> — .evals/.env.staging, .evals/.env.dev — and never commit the copies.

# --- the system under evaluation ---
EVAL_MODEL=                 # exact model id, never an alias ending in "latest"
EVAL_TEMPERATURE=0
PROMPT_PATH=                # the version-controlled system prompt
PROMPT_VERSION=             # git sha, file header, or const — recorded in every run
SYSTEM_BASE_URL=            # when the adapter calls an HTTP surface

# --- the judge (must not share a model family with the system, in gated suites) ---
JUDGE_MODEL=
JUDGE_TEMPERATURE=0

# --- generation and simulation ---
SYNTH_MODEL=                # synthetic case generation — never the judge model
SIM_USER_MODEL=             # L3 user simulator — never the agent model

# --- provider keys ---
ANTHROPIC_API_KEY=

# --- trace source (L6 / /eval-explore) ---
TRACE_SOURCE=               # path, query, or endpoint

# --- verdict report hub ---
VERDICT_URL=
VERDICT_API_KEY=
VERDICT_PROJECT=

# --- budget guards: the runner aborts rather than spending silently ---
EVAL_TOKEN_BUDGET=
EVAL_COST_CEILING=
